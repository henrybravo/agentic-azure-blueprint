// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Agentic Azure Blueprint",
	// Build from a Dockerfile to remove stale apt sources before features install.
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/azure-cli:1": {
			"installBicep": true,
			"version": "latest",
			"bicepVersion": "latest"
		},
		"ghcr.io/devcontainers-community/npm-features/typescript:1": {
			"version": "latest"
		},
		"ghcr.io/azure/azure-dev/azd:0": {
			"version": "stable"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": true,
			"azureDnsAutoDetection": true,
			"installDockerBuildx": true,
			"installDockerComposeSwitch": true,
			"version": "latest",
			"dockerDashComposeVersion": "none"
		},
		"ghcr.io/devcontainers/features/dotnet:2": {
			"version": "9.0"
		},
		"ghcr.io/dotnet/aspire-devcontainer-feature/dotnetaspire:1": {
			"version": "latest"
		},
		"ghcr.io/devcontainers-extra/features/mkdocs:2": {
			"version": "latest",
			"plugins": "mkdocs-material pymdown-extensions mkdocstrings[crystal,python] mkdocs-monorepo-plugin mkdocs-pdf-export-plugin mkdocs-awesome-pages-plugin mkdocs-minify-plugin mkdocs-git-revision-date-localized-plugin"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot-chat",
				"ms-vscode.vscode-node-azure-pack",
				"ms-windows-ai-studio.windows-ai-studio",
				"ms-dotnettools.csdevkit",
				"microsoft-aspire.aspire-vscode",
				"ms-dotnettools.vscode-dotnet-pack"
			]
		}
	},

	// Install APM CLI after container creation
	"postCreateCommand": "pip install --user apm-cli && apm --version",

	// Pass through GitHub tokens from local environment
	"remoteEnv": {
		"GITHUB_COPILOT_PAT": "${localEnv:GITHUB_COPILOT_PAT}",
		"GITHUB_APM_PAT": "${localEnv:GITHUB_APM_PAT}"
	}
}
