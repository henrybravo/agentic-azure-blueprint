# Agentic API (BFF) — example environment. Copy to .env and fill in.
# No secrets: auth uses managed identity in Azure; locally use `az login`.
AZURE_OPENAI_ENDPOINT=https://<AOAI_ACCOUNT>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=<MODEL_DEPLOYMENT_NAME>
ORCHESTRATOR_URL=http://localhost:8000
