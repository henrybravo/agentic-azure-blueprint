# Orchestrator — example environment. Copy to .env and fill in.
# No secrets: use managed identity in Azure; locally use `az login`.
AZURE_OPENAI_ENDPOINT=https://<AOAI_ACCOUNT>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=<MODEL_DEPLOYMENT_NAME>
# Optional durable memory; unset => in-memory checkpointer:
# AZURE_COSMOS_ENDPOINT=https://<COSMOS_ACCOUNT>.documents.azure.com:443/
