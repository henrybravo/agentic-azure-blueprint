# Frontend — example environment. Copy to .env.local.
# AGENT_API_URL points the UI at the BFF (set automatically by Aspire when run via apphost).
AGENT_API_URL=http://localhost:8080

# --- Optional UI sign-in gate (fallback when Entra ID sign-in is not available) ---
# When BOTH are set, the UI requires this login before any page or API call (incl. the
# BFF proxy). Leave unset to keep the UI open, or once Entra ID sign-in is wired instead.
# These are demo credentials — replace them for any real deployment.
UI_AUTH_USERNAME=adminuser
UI_AUTH_PASSWORD=adminusermypasswd!
# Optional HMAC secret for the session cookie (defaults to UI_AUTH_PASSWORD if unset).
# UI_AUTH_SECRET=change-me-to-a-long-random-string
